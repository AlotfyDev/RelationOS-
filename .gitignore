# RelationOS GitIgnore - Clean Production Repository

# Development Environment (DO NOT COMMIT)
.clinerules/
.kilocode/
.vscode/
.env
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Build and Distribution
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual Environment
ENV/
env/
.ENV/
.envrc

# IDE Files
*.swp
*.swo
*~

# OS Files
.DS_Store
Thumbs.db

# Python Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# Environment Variables
.env
.env.local
.env.production

# Model Cache (Large files - exclude from repo)
models/cache/
*.model
*.pkl
*.h5

# Data Outputs (Generated files)
data/relations_harvested.parquet
analysis_results.csv
analysis_reports/
relationos_analysis_*.csv
relationos_analysis_*.json
relationos_analysis_*.log

# Temporary Files
*.tmp
*.temp
temp/
tmp/

# Log Files
*.log
logs/

# Cache Directories
.cache/
__pycache__/
.pytest_cache/

# Development Scripts (Keep only production scripts)
dev_*.py
test_*.py (unless unit tests)
debug_*.py

# Documentation Build (if using Sphinx)
docs/_build/

# User-specific files
user_*.py
custom_*.py
